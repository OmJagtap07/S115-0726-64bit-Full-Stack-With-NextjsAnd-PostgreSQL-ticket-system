generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
// Stores agents and administrators

model User {
  id String @id @default(cuid())
}

// Ticket Model
// Stores customer support tickets

model Ticket {
  id String @id @default(cuid())
}

// Message Model
// Stores ticket replies

model Message {
  id String @id @default(cuid())
}